#!/usr/bin/env python3
"""
Create the page and raffle files for a monthly club meeting.

Usage:
    ./script/new-meeting            # the month after the last meeting held
    ./script/new-meeting 202612     # a specific month

Creates meetings/YYYY/YYYYMM.md dated the first Friday of the month,
_includes/raffle/YYYYMM.md, and placeholder raffle prize images. It never
overwrites existing files, so running it twice is harmless.

The homepage and the meetings page show the earliest meeting dated today or
later, so there is nothing else to update.
"""

import calendar
import datetime
import re
import shutil
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
PRIZES = ["1st", "2nd", "3rd", "4th", "5th"]

PAGE = """---
layout: meeting
title: "{month_name} Monthly Meeting"
date: {date}
topic: "To be announced"
presenter: "To be announced"
raffle: true
---

## Details

## Presentation materials

## Raffle

{{% include raffle/{ym}.md %}}
"""

RAFFLE = """
<details>
  <summary><b>Click the ticket to see the raffle prizes! <img src="/images/raffle-ticket.png" alt="raffle-ticket" width="90"></b></summary>
  <table>
    <tr>
{headers}
    </tr>
    <tr>
{images}
    </tr>
    <tr>
{descriptions}
    </tr>
  </table>
</details>
"""


def last_meeting_held():
    """YYYYMM of the newest meeting page dated before today."""
    today = datetime.date.today().isoformat()
    held = []
    for p in ROOT.glob("meetings/[0-9][0-9][0-9][0-9]/*.md"):
        m = re.search(r"^date: (\d{4}-\d{2}-\d{2})$", p.read_text(), re.M)
        if re.fullmatch(r"\d{6}", p.stem) and m and m.group(1) < today:
            held.append(p.stem)
    return max(held)


def month_after(ym):
    year, month = int(ym[:4]), int(ym[4:])
    return f"{year + 1}01" if month == 12 else f"{year}{month + 1:02d}"


def first_friday(year, month):
    for day in range(1, 8):
        if calendar.weekday(year, month, day) == calendar.FRIDAY:
            return datetime.date(year, month, day)


def main():
    if len(sys.argv) > 2 or (len(sys.argv) == 2 and not re.fullmatch(r"20\d{2}(0[1-9]|1[0-2])", sys.argv[1])):
        sys.exit(__doc__)
    ym = sys.argv[1] if len(sys.argv) == 2 else month_after(last_meeting_held())
    year, month = int(ym[:4]), int(ym[4:])
    date = first_friday(year, month)

    page = ROOT / f"meetings/{year}/{ym}.md"
    raffle = ROOT / f"_includes/raffle/{ym}.md"
    placeholder = ROOT / "meetings/raffle/raffle_prize.png"
    images = [ROOT / f"meetings/raffle/{year}/{ym}-{n}.png" for n in range(1, 6)]

    existing = [p for p in [page, raffle] + images if p.exists()]
    if existing:
        print("Nothing was created; these files already exist:")
        for p in existing:
            print(f"  {p.relative_to(ROOT)}")
        sys.exit(1)

    page.parent.mkdir(parents=True, exist_ok=True)
    page.write_text(PAGE.format(month_name=calendar.month_name[month], date=date, ym=ym))

    order = list(reversed(range(5)))  # 5th prize first, as on past raffles
    raffle.write_text(RAFFLE.format(
        headers="\n".join(f"        <th>{PRIZES[i]} prize</th>" for i in order),
        images="\n".join(
            f'        <td><img src="/meetings/raffle/{year}/{ym}-{i + 1}.png" alt="{PRIZES[i]} prize"></td>'
            for i in order),
        descriptions="\n".join(f"        <td>{PRIZES[i]} Prize description</td>" for i in order),
    ))

    images[0].parent.mkdir(parents=True, exist_ok=True)
    for image in images:
        shutil.copyfile(placeholder, image)

    print(f"Created the {calendar.month_name[month]} {year} meeting, dated {date:%A, %B %-d, %Y}:")
    for p in [page, raffle] + images:
        print(f"  {p.relative_to(ROOT)}")
    print()
    print("If the first Friday is a holiday, change `date:` in the meeting page.")
    print("Fill in `topic:` and `presenter:` when they are known.")


if __name__ == "__main__":
    main()
